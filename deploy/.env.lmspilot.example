# Pin images/digests in production.
REDIS_IMAGE=redis:7-alpine
REDIS_PASSWORD=change-this-long-random-secret

DOCUMENT_EDITOR_IMAGE=onlyoffice/documentserver:latest
DOCUMENT_EDITOR_JWT_SECRET=change-this-long-random-secret

LOCAL_AI_IMAGE=ollama/ollama:latest

# API key encryption; provide through secret manager, never commit the real value.
LMSPILOT_MASTER_KEY_BASE64=
# ---------- Learning paths / internal service calls ----------
LEARNING_SERVICE_CONNECT_TIMEOUT_MS=3000
LEARNING_SERVICE_READ_TIMEOUT_MS=5000

# ---------- Notification automation ----------
NOTIFICATION_REMINDER_WORKER_DELAY_MS=60000
NOTIFICATION_REMINDER_RETRY_DELAY_SECONDS=300
NOTIFICATION_REPORTING_CONNECT_TIMEOUT_MS=3000
NOTIFICATION_REPORTING_READ_TIMEOUT_MS=5000

