# ---------- Core ----------
LMSPILOT_ENV=development
LMSPILOT_PUBLIC_URL=http://localhost:3000
LMSPILOT_GATEWAY_URL=http://api-gateway:8080
LMSPILOT_JWT_SECRET=replace-with-at-least-64-random-characters-before-production
LMSPILOT_INTERNAL_TOKEN=replace-with-a-long-random-service-token
CONFIGURATION_SECRET_KEY=replace-with-a-long-random-configuration-encryption-key
AI_SECRET_KEY=replace-with-a-long-random-ai-encryption-key
LMSPILOT_DEFAULT_ADMIN_PASSWORD=ChangeMe-Immediately-123!
LMSPILOT_SEED_DEMO=true
# false khi chạy HTTP nội bộ; chỉ bật true sau khi đã cấu hình HTTPS.
LMSPILOT_COOKIE_SECURE=false

# ---------- PostgreSQL ----------
POSTGRES_DB=lmspilot
POSTGRES_ADMIN_PASSWORD=replace-with-random-postgres-admin-password
POSTGRES_SERVICE_PASSWORD=replace-with-random-service-database-password

# ---------- RabbitMQ / Redis ----------
RABBITMQ_DEFAULT_USER=lmspilot
RABBITMQ_DEFAULT_PASS=rabbit-dev-only
REDIS_PASSWORD=redis-dev-only

# ---------- File storage ----------
FILE_STORAGE_ROOT=/var/lib/lmspilot/files
FILE_MAX_SIZE=200MB
FILE_MAX_REQUEST_SIZE=210MB
FILE_MAX_SIZE_BYTES=209715200
FILE_ALLOWED_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,video/mp4,audio/mpeg,image/png,image/jpeg,text/plain,text/csv


# ---------- LDAP / Active Directory (optional) ----------
LDAP_ENABLED=false
LDAP_URL=ldaps://ad.internal:636
# Direct bind examples: uid={0},ou=people,dc=example,dc=local or {0}@example.local
LDAP_USER_DN_PATTERN=
# Search-bind mode (used when LDAP_USER_DN_PATTERN is empty)
LDAP_BASE_DN=dc=example,dc=local
LDAP_USER_SEARCH_FILTER=(sAMAccountName={0})
LDAP_MANAGER_DN=
LDAP_MANAGER_PASSWORD=
LDAP_CONNECT_TIMEOUT_MS=3000
LDAP_READ_TIMEOUT_MS=5000

# ---------- Learning / assignments ----------
LEARNING_ASSIGNMENT_MAX_ATTEMPTS=10

# ---------- SMTP (optional) ----------
NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=mail.internal
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
NOTIFICATION_FROM=no-reply@lmspilot.local
NOTIFICATION_EMAIL_MAX_ATTEMPTS=8
NOTIFICATION_EMAIL_INITIAL_BACKOFF=PT1M
NOTIFICATION_EMAIL_MAX_BACKOFF=PT6H
NOTIFICATION_EMAIL_PROCESSING_LEASE=PT5M

# ---------- Local AI (optional) ----------
AI_ENABLED=false
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_MODEL=qwen3:8b
AI_API_KEY=local-only

# ---------- License development mode ----------
LMSPILOT_ALLOW_DEVELOPMENT_LICENSE=true
LMSPILOT_LICENSE_PUBLIC_KEY=
LMSPILOT_MACHINE_FINGERPRINT=development
# ---------- Learning paths / internal service calls ----------
LEARNING_SERVICE_CONNECT_TIMEOUT_MS=3000
LEARNING_SERVICE_READ_TIMEOUT_MS=5000

# ---------- Notification automation ----------
NOTIFICATION_REMINDER_WORKER_DELAY_MS=60000
NOTIFICATION_REMINDER_RETRY_DELAY_SECONDS=300
NOTIFICATION_REPORTING_CONNECT_TIMEOUT_MS=3000
NOTIFICATION_REPORTING_READ_TIMEOUT_MS=5000


# ---------- Backup security ----------
# Chỉ bật khi thư mục backup nằm trên ổ đĩa/môi trường đã mã hóa.
LMSPILOT_BACKUP_INCLUDE_SECRETS=false
